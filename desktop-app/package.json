{
  "name": "flipscout-desktop",
  "version": "1.19.0",
  "description": "FlipScout — MLS fixer-flip scanner (desktop). Log in, scan the buy box, photo-verify, and generate a deal report.",
  "main": "main.js",
  "author": "Twin Home Buyer",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "test": "node test-google-sheets.js",
    "dist": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.twinhomebuyer.flipscout",
    "productName": "FlipScout",
    "files": ["main.js", "preload.js", "scan-core.js", "google-sheets.js", "renderer/**/*"],
    "win": {
      "target": ["nsis", "portable"]
    },
    "portable": { "artifactName": "FlipScout-${version}-portable.${ext}" },
    "nsis": {
      "artifactName": "FlipScout-${version}-setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  }
}
