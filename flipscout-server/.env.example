# Copy to .env on the server and fill in. NEVER commit the filled version —
# .env is gitignored, and these are live credentials to a real CRM.

# Who the server calls the API
PORT=8080
# A long random string. Anything holding this can create contacts in the CRM.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_TOKEN=

# ---- REI BlackBook ----
REI_BASE=https://my.reiblackbook.com
REI_USER=
REI_PASS=
# The contact profile the Add Contact form saves into. 5289 on Twin Home
# Buyer's account; check it if contacts start saving into the wrong profile.
REI_PROFILE_ID=5289
# Where the session cookie lives between restarts. Keep it on a persistent
# volume, or every restart triggers a fresh login and another emailed code.
REI_STATE_PATH=./data/rei-session.json

# ---- the mailbox REI sends verification codes to ----
# Without this the server cannot log in again by itself when the session dies.
# For Gmail use an App Password, not the account password.
MAIL_HOST=imap.gmail.com
MAIL_PORT=993
MAIL_USER=
MAIL_PASS=
MAIL_MAX_AGE=600

QUEUE_PATH=./data/queue.json
