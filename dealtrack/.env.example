# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Google Ads API. See README.md for where each value comes from.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# The ad account to report on: 10 digits, dashes optional. Twin Home Buyer is 989-715-5298.
GOOGLE_ADS_CUSTOMER_ID=
# Only if the login reaches the account through a manager account.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Team password for viewing the dashboard. Required when the app is online.
APP_PASSWORD=
# Admin password: lets you add negative keywords, exclude cities, push the weekly negatives, and
# pause campaigns at the budget's pause line, from the dashboard. Leave empty to keep the dashboard
# read-only. Use a different password than above.
ADMIN_PASSWORD=
# Any long random string. Changing it signs everyone out.
SESSION_SECRET=

# ---- Forecast: the "PPC LEAD" Google Sheet (lead stages and acquired deals) ----
# The sheet ID is the part of its URL between /d/ and /edit.
LEADS_SHEET_ID=
# A refresh token for the same Google client as above, created with the
# https://www.googleapis.com/auth/spreadsheets.readonly scope. Leave empty if GOOGLE_ADS_REFRESH_TOKEN
# was created with both the Ads and Sheets scopes.
GOOGLE_SHEETS_REFRESH_TOKEN=

# ---- Behavior and alerts: PostHog (personal API key, "Read-only access" preset, one project) ----
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_HOST=https://us.posthog.com

# ---- Alerts: Microsoft Clarity (Settings → Data export → Generate new API token) ----
CLARITY_API_TOKEN=

# ---- Landing pages: Google PageSpeed Insights API key (Google Cloud → Credentials → API key,
# with the PageSpeed Insights API enabled). Free; without it Google's shared quota runs out.
PAGESPEED_API_KEY=

# ---- Optional ----
# Where DealTrack saves its own data (budget lines, alert history, weekly negatives, audit ticks).
# Leave empty for the .data folder here.
DEALTRACK_DATA_DIR=
# Set to 1 to try the change buttons safely: Google checks each change and applies nothing.
DEALTRACK_VALIDATE_ONLY=
# Set to 0 to stop fetching the main reports in the background when the server starts.
DEALTRACK_WARMUP=

# ---- Google sign-in ("Continue with Google") ----
# Who may sign in: addresses and/or whole domains, comma-separated. Google sign-in stays off until set.
ALLOWED_EMAILS=
# Who also gets admin (changes in Google Ads).
ADMIN_EMAILS=
# Optional: a separate Google client for sign-in (defaults to GOOGLE_ADS_CLIENT_ID/SECRET). Either way,
# add http://localhost:3000/api/auth/google/callback to the client's Authorized redirect URIs.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Once online: the address, e.g. https://dealtrack.example.com
# SITE_URL=

# ---- Website leads ----
# The key WordPress sends with each lead. Leave empty and one is created in .data.
# LEADS_WEBHOOK_SECRET=

# ---- The "Ask about your ads" chat: fill in one ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Or no key: ASSISTANT_PROVIDER=claude-code uses the Claude Code app on this computer (setup-claude.bat).
# ASSISTANT_PROVIDER=claude-code
# OPENAI_MODEL=gpt-5.5
