# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Google Ads API. See README.md for where each value comes from.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# The ad account to report on: 10 digits, dashes optional. Twin Home Buyer is 989-715-5298.
GOOGLE_ADS_CUSTOMER_ID=
# Only if the login reaches the account through a manager account.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Team password for viewing the dashboard. Required when the app is online.
APP_PASSWORD=
# Admin password: lets you add negative keywords and exclude cities in Google Ads from the
# dashboard. Leave empty to keep the dashboard read-only. Use a different password than above.
ADMIN_PASSWORD=
# Any long random string. Changing it signs everyone out.
SESSION_SECRET=
